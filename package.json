{
  "name": "active-class",
  "version": "1.4.0",
  "description": "Active Class - تطبيق إدارة الفصل التفاعلي باستخدام Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-rebuild -f -w better-sqlite3 && electron-builder --win",
    "server": "node server/server.js",
    "migrate:sqlite": "node server/migrate-sqlite.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node --test \"tests/integration/**/*.test.js\"",
    "test:all": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "firebase-admin": "^14.1.0",
    "mathjs": "^15.2.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.activeclassapp.classroom-manager",
    "productName": "Active Class",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Active Class",
      "installerLanguages": [
        "ar",
        "en"
      ]
    },
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.js",
      "public/**/*",
      "server/**/*",
      "package.json",
      "!public/admin-licenses.html",
      "!node_modules/.bin",
      "!node_modules/xlsx/dist/cpexcel.full.mjs",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/wasm/**",
      "!node_modules/pdfjs-dist/iccs/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/build/pdf.mjs",
      "!node_modules/pdfjs-dist/build/pdf.worker.mjs",
      "!node_modules/pdfjs-dist/build/pdf.sandbox.mjs",
      "!node_modules/pdfjs-dist/build/pdf.image_decoders.mjs",
      "!node_modules/pdf-parse/lib/pdf.js/**",
      "!node_modules/pdf-parse/test/**",
      "!**/*.md",
      "!**/*.map",
      "!**/*.ts",
      "!**/test/**",
      "!**/tests/**",
      "!**/docs/**",
      "!data/**",
      "!db.json",
      "!**/*.db",
      "!**/*.sqlite",
      "!**/*.sqlite3",
      "!public/uploads/**"
    ],
    "asarUnpack": [
      "server/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/firebase-admin/**/*",
      "node_modules/@google-cloud/**/*",
      "node_modules/@grpc/**/*"
    ],
    "extraResources": [],
    "publish": {
      "provider": "github",
      "owner": "amertimraz",
      "repo": "Active-Class-windows"
    }
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "electron": "^39.3.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.14",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0"
  }
}
